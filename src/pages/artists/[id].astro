---
import Layout from '../../layouts/Layout.astro';
import CardArtist from '../../components/CardArtist.astro';
import {getOneArtiste, getArtistesBySceneId} from '../../script/backend.mjs'
import {formatDate} from '../../script/helpers.js'
import PbImage from '../../components/PbImage.astro';

const { id } = Astro.params;
const artist = await getOneArtiste(id);
---

<Layout titre={"Jumelages - " + artist.nom}>
	<h1 class="font-barrio text-6xl text-center mt-10 mb-10">{artist.nom}</h1>
    <div class="flex justify-center">
        <PbImage class="mx-auto" record={artist} recordImage={artist.photo} />
    </div>
    <p class="text-center font-poppins text-xl mt-5">{formatDate(artist.date_de_presentation)}</p>
    <p class="mx-auto font-poppins text-center text-xl mt-5 w-[1500px]">{artist.description_longue}</p>
    <div class="flex justify-center gap-2 max-w-4xl mx-auto mb-4">
        <p class="w-auto mx-auto bg-jum-red text-black px-3 py-3 rounded-full text-center font-poppins text-xl mt-5 shadow-lg">{artist.style_de_musique[0]}</p>
        <p class="w-auto mx-auto bg-jum-red text-black px-3 py-3 rounded-full text-center font-poppins text-xl mt-5 shadow-lg">{artist.style_de_musique[1]}</p>
        <p class="w-auto mx-auto bg-jum-yellow text-black px-3 py-3 rounded-full text-center font-poppins text-xl mt-5 shadow-lg">{artist.mood_musical[0]}</p>
        <p class="w-auto mx-auto bg-jum-yellow text-black px-3 py-3 rounded-full text-center font-poppins text-xl mt-5 shadow-lg">{artist.mood_musical[1]}</p>
    </div>
    <h3 class="font-barrio text-3xl text-center mt-10 mb-10">gallerie d'image</h1>
    <div class="grid grid-cols-3 gap-2 mx-auto max-w-4xl mb-4">
        <PbImage record={artist} recordImage={artist.gallerie[0]} />
        <PbImage record={artist} recordImage={artist.gallerie[1]} />
        <PbImage record={artist} recordImage={artist.gallerie[2]} />
    </div>
</Layout>