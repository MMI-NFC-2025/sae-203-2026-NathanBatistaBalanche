---
import Layout from '../../../layouts/Layout.astro';
import { addNewArtiste } from '../../../script/backend.mjs';

let message = '';

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	const response = await addNewArtiste(formData);
}
---

<Layout titre="Jumelages - Ajouter un artiste">

	<h1 class="font-barrio text-5xl text-center mt-10">Ajouter un artiste</h1>

	<section class="min-h-screen bg-gradient-to-br py-12 px-4 sm:px-6 lg:px-8">
		<div class="max-w-md mx-auto bg-[#FDCE53] rounded-2xl shadow-xl p-8 sm:p-10">

			<div class="text-center mb-8">
				<h2 class="font-anonymous text-3xl font-bold text-gray-900 mb-2">Nouvel artiste</h2>
				<p class="font-poppins text-gray-600">Ajouter un artiste dans la base de données</p>
			</div>

			<form method="POST" class="space-y-6">

				<!-- Nom -->
				<div>
					<label class="font-anonymous text-xl block text-black mb-2">
						Nom de l'artiste <span class="text-[#FB6E6E]">*</span>
					</label>
					<input
						type="text"
						name="nom"
						required
						class="w-full px-4 py-3 border font-poppins border-[#FB6E6E] rounded-xl"
						placeholder="Nom de l'artiste"
					/>
				</div>

				<!-- Description courte -->
				<div>
					<label class="font-anonymous text-xl block text-black mb-2">
						Description courte
					</label>
					<textarea
						name="description_courte"
						rows="2"
						class="w-full px-4 py-3 border font-poppins border-[#FB6E6E] rounded-xl"
						placeholder="Description courte"
					></textarea>
				</div>

				<!-- Description longue -->
				<div>
					<label class="font-anonymous text-xl block text-black mb-2">
						Description longue
					</label>
					<textarea
						name="description_longue"
						rows="4"
						class="w-full px-4 py-3 border font-poppins border-[#FB6E6E] rounded-xl"
						placeholder="Description longue"
					></textarea>
				</div>

				<!-- Style musical -->
				<div>
					<p class="font-anonymous text-xl mb-2">Style musical (2 max)</p>
					<div class="grid grid-cols-2 gap-2 font-poppins">

						<label class="flex gap-2">
							<input type="checkbox" name="style_de_musique" value="Folk"> Folk
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="style_de_musique" value="Pop"> Pop
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="style_de_musique" value="Rock"> Rock
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="style_de_musique" value="Bal"> Bal
						</label>

					</div>
				</div>

				<!-- Mood musical -->
				<div>
					<p class="font-anonymous text-xl mb-2">Mood musical (2 max)</p>
					<div class="grid grid-cols-2 gap-2 font-poppins">

						<label class="flex gap-2">
							<input type="checkbox" name="mood_musical" value="Energique"> Energique
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="mood_musical" value="Traditionnel"> Traditionnel
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="mood_musical" value="Poetique"> Poétique
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="mood_musical" value="Dansant"> Dansant
						</label>

					</div>
				</div>

				<!-- Date de présentation -->
				<div>
					<p class="font-anonymous text-xl mb-2">Mood musical (1 max)</p>
					<div class="grid grid-cols-2 gap-2 font-poppins">

						<label class="flex gap-2">
							<input type="checkbox" name="date" value="28aout"> 28 Aout
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="date" value="29aout"> 29 Aout
						</label>

						<label class="flex gap-2">
							<input type="checkbox" name="date" value="30aout"> 30 Aout
						</label>

					</div>
				</div>

				<button
					type="submit"
					class="w-full bg-[#FB6E6E] hover:bg-[#e65757] text-white font-semibold py-4 px-6 rounded-xl"
				>
					Ajouter l'artiste
				</button>

			</form>

			{
				message && (
					<p class="text-green-600 text-center mt-6">{message}</p>
				)
			}

		</div>
	</section>

</Layout>