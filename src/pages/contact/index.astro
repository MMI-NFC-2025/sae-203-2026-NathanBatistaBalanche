---
import Layout from '../../layouts/Layout.astro';
import { sendContactForm } from '../../script/backend.mjs';

let message = '';

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	const response = await sendContactForm(formData);
}
---

<Layout titre="Jumelages - Contact">
	<h1 class="font-barrio text-5xl text-center mt-10 mb-10">contact</h1>

	<section class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
		<div class="max-w-md mx-auto bg-white rounded-2xl shadow-xl p-8 sm:p-10">

			<div class="text-center mb-8">
				<h2 class="text-3xl font-bold text-gray-900 mb-2">Nous contacter</h2>
				<p class="text-gray-600">Remplissez le formulaire pour nous envoyer un message</p>
			</div>

			<form method="POST" class="space-y-6">

				<div>
					<label for="nom" class="block text-sm font-medium text-gray-700 mb-2">
						Nom <span class="text-red-500">*</span>
					</label>
					<input
						type="text"
						id="nom"
						name="nom"
						required
						class="w-full px-4 py-3 border border-gray-300 rounded-xl"
						placeholder="Votre nom"
					/>
				</div>

				<div>
					<label for="mail" class="block text-sm font-medium text-gray-700 mb-2">
						Email <span class="text-red-500">*</span>
					</label>
					<input
						type="email"
						id="mail"
						name="mail"
						required
						class="w-full px-4 py-3 border border-gray-300 rounded-xl"
						placeholder="votre@email.com"
					/>
				</div>

				<div>
					<label for="sujet" class="block text-sm font-medium text-gray-700 mb-2">
						Sujet <span class="text-red-500">*</span>
					</label>
					<input
						type="text"
						id="sujet"
						name="sujet"
						required
						class="w-full px-4 py-3 border border-gray-300 rounded-xl"
						placeholder="Objet de votre message"
					/>
				</div>

				<div>
					<label for="message" class="block text-sm font-medium text-gray-700 mb-2">
						Message <span class="text-red-500">*</span>
					</label>
					<textarea
						id="message"
						name="message"
						rows="5"
						required
						class="w-full px-4 py-3 border border-gray-300 rounded-xl"
						placeholder="Votre message..."
					></textarea>
				</div>

				<button
					type="submit"
					class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-4 px-6 rounded-xl"
				>
					Envoyer le message
				</button>

			</form>

			{
				message && (
					<p class="text-green-600 text-center mt-6">{message}</p>
				)
			}

			<div class="mt-6 text-xs text-gray-500 text-center">
				<p><span class="text-red-500 font-medium">*</span> Champs obligatoires</p>
			</div>

		</div>
	</section>
</Layout>