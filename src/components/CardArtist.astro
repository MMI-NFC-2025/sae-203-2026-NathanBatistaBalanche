---
const { artist } = Astro.props;
import {formatDate} from '../script/helpers.js'
import PbImage from './PbImage.astro';
---

<ul class="max-width-[1500px] bg-[#FB6E6E] rounded-lg p-3 shadow-2xl shadow-red-500/10 hover:shadow-[#FDCE53]/25 group relative transition-all duration-300 hover:-translate-y-1 overflow-hidden flex flex-col space-y-1 text-xs font-medium">
    <li class="flex-1 flex items-center justify-center mb-4">
        <PbImage record={artist} recordImage={artist.photo} />
   </li>
    <li>
        <h4 class="font-anonymous text-xl text-black text-base truncate leading-tight mb-1 text-center">{artist.nom}</h4>
    </li>
    <li class="text-black text-xs truncate leading-tight mb-1">{artist.description_courte}</li>
    <li class="text-black font-bold text-sm drop-shadow-lg">{formatDate(artist.date_de_presentation)}</li>
    <li>
        <a href={`/artists/${artist.id}`} class="underline">
            Voir plus
        </a>
    </li>
</ul>